{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "outDir": ".build/src",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false,
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["dist", ".build", "node_modules"]
}
