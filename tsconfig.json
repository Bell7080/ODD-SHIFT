{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": "src",
    "noEmitOnError": false,
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*.ts"]
}
